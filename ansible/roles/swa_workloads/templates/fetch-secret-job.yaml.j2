# =============================================================================
# fetch-secret — one-shot demo Job
# Rendered from ansible/roles/swa_workloads; applied/re-run by scripts/demo/swa/.
#
# Reuses the swa-probe namespace + ServiceAccount, so it authenticates with the
# exact SPIFFE ID the probe validated:
#   spiffe://<trust-domain>/k8s-nodegroup/ns/swa-probe/sa/swa-probe
# Runs once, prints its result, and exits — ideal for a live demo. Re-run it
# with `kubectl delete job fetch-secret` then re-apply (see 30_reset.sh).
# =============================================================================
apiVersion: batch/v1
kind: Job
metadata:
  name: fetch-secret
  namespace: {{ swa_probe_namespace }}
  labels:
    app: fetch-secret
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 300
  template:
    metadata:
      labels:
        app: fetch-secret
    spec:
      serviceAccountName: swa-probe
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: fetch-secret
          image: {{ fetch_secret_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: SWA_SOCKET_PATH
              value: {{ swa_socket_path }}
            - name: SWA_AUDIENCE
              value: {{ swa_audience }}
            - name: SWA_WAIT_TIMEOUT
              value: "{{ swa_wait_timeout }}"

            # --- Secrets Manager tenant params ---
            - name: SECRETS_MGR_SUBDOMAIN
              value: "{{ swa_sm_subdomain }}"
            - name: SECRETS_MGR_JWT_SERVICE_ID
              value: "{{ swa_sm_jwt_service_id }}"
            - name: SECRETS_MGR_PASSWORD_VAR
              value: "{{ swa_sm_password_var }}"
            - name: SECRETS_MGR_USERNAME_VAR
              value: "{{ swa_sm_username_var }}"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
          volumeMounts:
            - name: swa-agent-socket
              mountPath: {{ swa_socket_dir }}
              readOnly: true
      volumes:
        - name: swa-agent-socket
          hostPath:
            path: {{ swa_socket_dir }}
            type: Directory
